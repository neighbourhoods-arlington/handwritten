# ──────────────────────────────────────────────────────────────
# Web (frontend) тохиргоо.  Хуулах: cp web/.env.example web/.env
# Framework сонгосны дараа prefix-ийг тохируулна
# (Vite: VITE_*, Next.js: NEXT_PUBLIC_*).
# ──────────────────────────────────────────────────────────────

# Browser-оос дуудах API хаяг
VITE_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Dev server порт
PORT=3000
