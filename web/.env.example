# ──────────────────────────────────────────────────────────────
# Web (Qwik City) settings.  Copy: cp web/.env.example web/.env
# Qwik exposes PUBLIC_* and VITE_* variables to the browser;
# everything else is server-only (SSR, routeLoader$, server$).
# ──────────────────────────────────────────────────────────────

# API base URL used by the browser
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# API base URL used during SSR (server side). Inside docker-compose this is
# overridden to http://api:8000/api/v1. Empty = fall back to PUBLIC_API_BASE_URL.
API_BASE_URL=
