# ──────────────────────────────────────────────────────────────
# Web (frontend) settings.  Copy: cp web/.env.example web/.env
# Keep the prefix that matches your framework
# (Vite: VITE_*, Next.js: NEXT_PUBLIC_*).
# ──────────────────────────────────────────────────────────────

# API base URL called from the browser
VITE_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Dev server port
PORT=3000
