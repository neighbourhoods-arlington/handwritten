# ──────────────────────────────────────────────────────────────
# API settings.  Copy: cp api/.env.example api/.env
# Used both for local runs (uvicorn on the host) and docker-compose.
# Under compose, POSTGRES_HOST / OLLAMA_BASE_URL are overridden by
# docker-compose.yml with the in-network container addresses.
# ──────────────────────────────────────────────────────────────

# App
APP_NAME=handwritten
APP_ENV=development            # development | staging | production
DEBUG=true
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (for local runs the compose db is exposed on host port 5432)
POSTGRES_USER=handwritten
POSTGRES_PASSWORD=handwritten
POSTGRES_DB=handwritten
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Leave empty to build the URL from the values above
DATABASE_URL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# The agent needs a model that supports tool calling (llama3.2, qwen3, mistral, ...).
# gemma3 does not support tools, so it is only used for vision/OCR.
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120

# MCP
MCP_SERVER_NAME=handwritten-mcp
MCP_MOUNT_PATH=/mcp
# MCP server the agent connects to. Empty = this app's own server, in-process.
MCP_CLIENT_URL=

# Agent (Ollama model calling MCP tools in a loop)
AGENT_MAX_STEPS=8

# Thank-you letters
WEB_BASE_URL=http://localhost:5173       # base URL for the QR / share link on each note
DONATE_LINK=phoenixbikes.org/donate      # required in every note
LETTER_MAX_CHARS=520                     # one Uuna Tek card
LETTER_SIMILARITY_THRESHOLD=0.75         # flag notes in a batch more similar than this
