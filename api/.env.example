# ──────────────────────────────────────────────────────────────
# API тохиргоо.  Хуулах: cp api/.env.example api/.env
# Локал (uvicorn хост дээр) болон docker-compose хоёуланд ашиглагдана.
# Compose ажиллуулахад POSTGRES_HOST / OLLAMA_BASE_URL-ийг
# docker-compose.yml автоматаар контейнерийн хаягаар дарна.
# ──────────────────────────────────────────────────────────────

# App
APP_NAME=handwritten
APP_ENV=development            # development | staging | production
DEBUG=true
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (локал ажиллуулахад: compose-ийн db хост дээр 5432-оор нээгдэнэ)
POSTGRES_USER=handwritten
POSTGRES_PASSWORD=handwritten
POSTGRES_DB=handwritten
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Хоосон орхивол дээрх утгуудаас автоматаар угсарна
DATABASE_URL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Агентад tool-calling дэмждэг модель хэрэгтэй (llama3.2, qwen3, mistral ...).
# gemma3 tool дэмжихгүй тул зөвхөн vision/OCR-д ашиглана.
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120

# MCP
MCP_SERVER_NAME=handwritten-mcp
MCP_MOUNT_PATH=/mcp
# Агент холбогдох MCP сервер. Хоосон = өөрийн серверт in-process.
MCP_CLIENT_URL=

# Agent (Ollama модель MCP tool-уудыг дуудах loop)
AGENT_MAX_STEPS=8
