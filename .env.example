# ──────────────────────────────────────────────────────────────
# Infrastructure settings for docker-compose (repo root)
# Copy: cp .env.example .env
# Per-app settings live in api/.env.example and web/.env.example
# ──────────────────────────────────────────────────────────────

# PostgreSQL (passed to both the db and api containers)
POSTGRES_USER=handwritten
POSTGRES_PASSWORD=handwritten
POSTGRES_DB=handwritten
POSTGRES_PORT=5432

# Ports exposed on the host
API_PORT=8000
WEB_PORT=5173

# Ollama address as seen from the api container
#   Ollama on the host (Mac/Windows/Linux): http://host.docker.internal:11434
#   With `--profile ollama`:                http://ollama:11434
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
