# ──────────────────────────────────────────────────────────────
# docker-compose-ийн дэд бүтцийн тохиргоо (root)
# Хуулах: cp .env.example .env
# Апп-ийн тохиргоо тус бүр: api/.env.example, web/.env.example
# ──────────────────────────────────────────────────────────────

# PostgreSQL (db контейнер + api контейнерт хоёуланд нь очно)
POSTGRES_USER=handwritten
POSTGRES_PASSWORD=handwritten
POSTGRES_DB=handwritten
POSTGRES_PORT=5432

# Хост дээр нээх портууд
API_PORT=8000
WEB_PORT=3000

# api контейнерээс Ollama-г дуудах хаяг
#   Хост дээрх Ollama (Mac/Windows/Linux): http://host.docker.internal:11434
#   `--profile ollama` ашиглавал:          http://ollama:11434
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
